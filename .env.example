PORT=3001
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
GOOGLE_MAPS_API_KEY=your-browser-restricted-maps-javascript-api-key
GOOGLE_ROUTES_API_KEY=your-server-restricted-routes-api-key
CLIENT_ORIGIN=http://localhost:5173
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=verified-sender@example.com
BREVO_SENDER_NAME=NAVIGO
# Alternatively, configure Gmail with an App Password (not your normal Gmail password).
GMAIL_USER=your-gmail-address@gmail.com
GMAIL_APP_PASSWORD=your-16-character-gmail-app-password
DATA_WORKBOOK_PATH=Navigo.xlsx
DEVICE_API_KEY=replace-with-a-long-random-device-secret

# Backend-only device-to-bus assignment. `ip` is optional; use it only for devices with a stable public IP.
DEVICE_REGISTRY_JSON=[{"deviceId":"gps-unit-001","busId":"B001"}]
