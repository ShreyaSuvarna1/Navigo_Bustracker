PORT=3001
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
GOOGLE_MAPS_API_KEY=your-browser-restricted-maps-javascript-api-key
GOOGLE_ROUTES_API_KEY=your-server-restricted-routes-api-key
CLIENT_ORIGIN=http://localhost:5173

# Gmail verification: enable 2-Step Verification, then create an App Password.
GMAIL_USER=your-gmail-address@gmail.com
GMAIL_APP_PASSWORD=your-16-character-gmail-app-password

# Local default is ../Navigo.xlsx. Set this for deployed environments.
DATA_WORKBOOK_PATH=../Navigo.xlsx
